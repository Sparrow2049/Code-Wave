  "questions": [
    {
      "id": "q1",
      "courseCode": "GEN100",
      "title": "What was the hardest class in freshman year?",
      "body": "Trying to plan out how much time to budget for each course this term — curious what upperclassmen found hardest and why.",
      "askedBy": "New Freshman",
      "resolved": true,
      "createdAt": "2026-09-09T04:11:46.588Z",
      "answers": [
        {
          "id": "65b35827-5d43-450b-92aa-0063906118a6",
          "questionId": "q1",
          "body": "In my experience the hardest class was Physics IA. It was mostly because we didn't understand the subject very well. On top of that the teacher was very harsh on us.",
          "answeredBy": "Arthur",
          "role": "senior",
          "createdAt": "2026-09-11T04:13:31.587Z"
        }
      ]
    },
    {
      "id": "q2",
      "courseCode": "MATH100",
      "title": "I failed my Pre-Calculus initial exam — what should I do now?",
      "body": "Just got my result back and I didn't pass the Pre-Calculus placement exam. Not sure what happens next — do I retake it, get placed in a different track, or something else? Has anyone been through this?",
      "askedBy": "New Freshman",
      "resolved": true,
      "createdAt": "2026-09-10T04:11:46.588Z",
      "answers": [
        {
          "id": "392ec441-cfde-4229-bdc2-405c1c7ad3a9",
          "questionId": "q2",
          "body": "No you just learn Pre-Calculus as normal. People who passed will not study Pre-Calculus that semester.",
          "answeredBy": "Arthur",
          "role": "senior",
          "createdAt": "2026-09-11T04:12:39.570Z"
        }
      ]
    }
  ]
